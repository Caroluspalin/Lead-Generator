# ============================================
# Agency Hunter — Backend env-muuttujat
# Kopioi tama tiedosto nimelle ".env" ja taytä
# ============================================

# --- Tietokanta ---
# Dev (SQLite):
#   DATABASE_URL=sqlite:///agency_hunter.db
# Tuotanto (Supabase / Postgres):
#   DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///agency_hunter.db
SQL_ECHO=false

# --- Supabase Auth ---
# Loydat namä: Supabase Dashboard → Project Settings → API
# SUPABASE_URL pakollinen ES256/RS256 -tokeneille (JWKS-verifiointi)
# SUPABASE_JWT_SECRET pakollinen HS256-legacy-tokeneille
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Dev-override: aseta "true" ohittaaksesi JWT-verifiointi paikallisessa kehityksessa
AUTH_DISABLED=false

# --- CORS ---
# Pilkuilla eroteltu lista sallituista origineista
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google Places ---
# https://console.cloud.google.com/google/maps-apis
GOOGLE_API_KEY=
USE_LIVE_GOOGLE=false

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Sähköpostien ja puhelinskriptien malli (oletus gpt-4o-mini, poistuu OpenAI:lta 14.1.2027)
EMAIL_MODEL=gpt-4o-mini
# Vain reasoning-malleille (GPT-6-sarja): none | low | medium | high. Jätä tyhjäksi gpt-4o-minille.
EMAIL_REASONING_EFFORT=
# Demosivujen sisällön malli (tyhjä = EMAIL_MODEL / EMAIL_REASONING_EFFORT)
SITE_MODEL=
SITE_REASONING_EFFORT=
# --- Demojen julkaisu (Cloudflare R2 + Worker) ---
# Julkinen osoite: Workerin workers.dev-osoite tai myöhemmin oma domain, https, ilman kauttaviivaa lopussa.
# Esim. https://agency-hunter-demos.<tilisi>.workers.dev  ->  myöhemmin https://demo.<domain>.fi
DEMO_PUBLIC_BASE_URL=
# R2 API -token (Object Read & Write, vain demo-bucketiin). Kaikki pakollisia julkaisuun.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agency-hunter-demos
# Julkaisun elinaika päivinä (Hired-liidin demo jatketaan automaattisesti)
DEMO_TTL_DAYS=30
# Unsplash-kuvat demosivuille (https://unsplash.com/developers). Tyhjä = gradientti ilman kuvia.
UNSPLASH_ACCESS_KEY=
# Attribuutiolinkkien utm_source (sovelluksen nimi Unsplashissa)
UNSPLASH_APP_NAME=agency_hunter

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
