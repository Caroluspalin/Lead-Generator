# ============================================
# Agency Hunter — Backend env-muuttujat
# Kopioi tama tiedosto nimelle ".env" ja taytä
# ============================================

# --- Tietokanta ---
# Dev (SQLite):
#   DATABASE_URL=sqlite:///agency_hunter.db
# Tuotanto (Supabase / Postgres):
#   DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///agency_hunter.db
SQL_ECHO=false

# --- Supabase Auth ---
# Loydat namä: Supabase Dashboard → Project Settings → API
# SUPABASE_URL pakollinen ES256/RS256 -tokeneille (JWKS-verifiointi)
# SUPABASE_JWT_SECRET pakollinen HS256-legacy-tokeneille
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Dev-override: aseta "true" ohittaaksesi JWT-verifiointi paikallisessa kehityksessa
AUTH_DISABLED=false

# --- CORS ---
# Pilkuilla eroteltu lista sallituista origineista
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google Places ---
# https://console.cloud.google.com/google/maps-apis
GOOGLE_API_KEY=
USE_LIVE_GOOGLE=false

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
