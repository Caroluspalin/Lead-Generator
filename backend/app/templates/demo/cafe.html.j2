{% extends "base_v2.html.j2" %}
{#
  Kahvila: "Paahtoaste". Sivu tummuu osio osiolta (sävyt 1–4) kuin papu paahdossa, ja heron
  iso pyöreä kuva kääntyy kerran sivun avautuessa. Alkuperä: portfolion esimerkki Pikkupaahtimo.
  Osiot, joille ei ole dataa (lounaslista, hinnat, pavut, sitaatti), on korvattu esittelyllä ja
  palvelulistalla. Ilman kuvaa osiot toimivat pelkällä tekstillä.
#}
{% block preload %}
<link rel="preload" href="{{ asset('cafe', 'young-serif.woff2').url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ asset('cafe', 'familjen-grotesk.woff2').url }}" as="font" type="font/woff2" crossorigin>
{% if hero_image %}<link rel="preload" as="image" href="{{ hero_image.src }}" imagesrcset="{{ hero_image.srcset }}" imagesizes="(min-width: 64rem) 60vw, 112vw" fetchpriority="high">{% endif %}
{% endblock %}
{% block body %}
<header class="yla savy-1">
  <div class="kehys yla-sisa">
    <a class="logo" href="#sisalto">{{ business.name }}</a>
    {% if week %}<a class="tila" href="#yhteys" data-tila>Aukioloajat</a>{% endif %}
  </div>
</header>

<main id="sisalto">
  <section class="hero savy-1">
    <div class="kehys hero-sisa">
      <div class="hero-teksti">
        <h1 data-pisin="{{ pisin(content.hero_title) }}">{{ content.hero_title }}</h1>
        <p class="hero-lause">{{ content.hero_subtitle }}</p>
        <div class="napit">
          {% if tel %}<a class="nappi" href="tel:{{ tel }}">Soita {{ business.phone }}</a>{% endif %}
          {% if business.maps_url %}<a class="nappi{% if tel %} nappi-toissijainen{% endif %}" href="{{ business.maps_url }}" rel="noopener noreferrer">Reittiohjeet</a>{% endif %}
        </div>
      </div>
      <div class="allas{% if not hero_image %} allas-tyhja{% endif %}" aria-hidden="true">
        {% if hero_image %}<img src="{{ hero_image.src }}" srcset="{{ hero_image.srcset }}" sizes="(min-width: 64rem) 60vw, 112vw" width="960" height="960" alt="" fetchpriority="high" decoding="async">{% endif %}
      </div>
    </div>
  </section>

  {% if summary or address_lines or business.phone %}
  <section class="tanaan savy-1" aria-label="Aukiolo ja osoite">
    <div class="kehys">
      <dl class="tanaan-rivi">
        {% if summary %}<div><dt>Tänään</dt><dd data-tanaan>{{ summary }}</dd></div>{% endif %}
        {% if address_lines %}<div><dt>Osoite</dt><dd>{{ address_lines | join(', ') }}</dd></div>{% endif %}
        {% if business.phone %}<div><dt>Puhelin</dt><dd>{% if tel %}<a href="tel:{{ tel }}">{{ business.phone }}</a>{% else %}{{ business.phone }}{% endif %}</dd></div>{% endif %}
      </dl>
    </div>
  </section>
  {% endif %}

  {% set esittely_kuva = mood_images[0] if mood_images | length > 0 else None %}
  {% set valikoima_kuva = mood_images[1] if mood_images | length > 1 else None %}
  {% set yhteys_kuva = mood_images[2] if mood_images | length > 2 else None %}

  <section id="meista" class="esittely savy-2{% if not esittely_kuva %} ilman-kuvaa{% endif %}" aria-labelledby="meista-otsikko">
    <div class="kehys esittely-sisa">
      {% if esittely_kuva %}
      <img class="esittely-kuva" src="{{ esittely_kuva.src }}" srcset="{{ esittely_kuva.srcset }}" sizes="(min-width: 64rem) 34rem, 100vw" width="1280" height="1600" alt="" loading="lazy" decoding="async">
      {% endif %}
      <div class="esittely-teksti">
        <h2 id="meista-otsikko" data-pisin="{{ pisin(about_title) }}">{{ about_title }}</h2>
        <p>{{ content.about }}</p>
      </div>
    </div>
  </section>

  <section id="valikoima" class="valikoima savy-3{% if not valikoima_kuva %} ilman-kuvaa{% endif %}" aria-labelledby="valikoima-otsikko">
    <div class="kehys valikoima-sisa{% if not valikoima_kuva %} ilman-kuvaa{% endif %}">
      {% if valikoima_kuva %}
      <img class="valikoima-kuva" src="{{ valikoima_kuva.src }}" srcset="{{ valikoima_kuva.srcset }}" sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 40vw, 100vw" width="1280" height="1600" alt="" loading="lazy" decoding="async">
      {% endif %}
      <div class="valikoima-lista">
        <h2 id="valikoima-otsikko">{{ tpl.services_title }}</h2>
        <ul class="palvelut">
          {% for service in content.services %}
          <li><h3>{{ service.name }}{% if service.price %} <span class="hinta">{{ service.price }}</span>{% endif %}</h3><p>{{ service.description }}</p></li>
          {% endfor %}
        </ul>
        <p class="huom">{{ tpl.services_lead }} {{ content.price_note }}{% if site_prices_note %} <span class="hinnat-lahde">{{ site_prices_note }}</span>{% endif %}</p>
      </div>
    </div>
  </section>

  <section id="yhteys" class="yhteys savy-4" aria-labelledby="yhteys-otsikko">
    <div class="kehys yhteys-sisa{% if not yhteys_kuva %} ilman-kuvaa{% endif %}">
      <div class="yhteys-teksti">
        <h2 id="yhteys-otsikko">Tervetuloa käymään</h2>
        {% if week %}
        <dl class="ajat">
          {% for row in week %}
          <div data-paiva="{{ row.paiva }}"{% if row.closed %} class="kiinni"{% endif %}><dt>{{ row.label }}</dt><dd>{{ row.value }}</dd></div>
          {% endfor %}
        </dl>
        {% else %}
        <p class="osoite">Kysykää aukioloajat puhelimitse.</p>
        {% endif %}
        {% if address_lines %}<p class="osoite">{% for line in address_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>{% endif %}
        {% if business.phone %}<p class="osoite">{% if tel %}<a href="tel:{{ tel }}">{{ business.phone }}</a>{% else %}{{ business.phone }}{% endif %}</p>{% endif %}
        {% if business.maps_url %}<p><a class="nappi nappi-toissijainen" href="{{ business.maps_url }}" rel="noopener noreferrer">Avaa kartalla</a></p>{% endif %}
      </div>
      {% if yhteys_kuva %}
      <img class="yhteys-kuva" src="{{ yhteys_kuva.src }}" srcset="{{ yhteys_kuva.srcset }}" sizes="(min-width: 64rem) 40vw, 100vw" width="1280" height="1600" alt="" loading="lazy" decoding="async">
      {% endif %}
    </div>
  </section>
</main>

<footer class="ala savy-4">
  <div class="kehys ala-sisa">
    <p>© {{ business.name }}{% if business.city %}, {{ business.city }}{% endif %}</p>
    {% if credits %}<p class="kiitos">Kuvat: {% for img in credits %}<a href="{{ img.credit_url }}" rel="noopener noreferrer">{{ img.credit_name }}</a>{% if not loop.last %}, {% endif %}{% endfor %} / <a href="{{ unsplash_url }}" rel="noopener noreferrer">Unsplash</a></p>{% endif %}
  </div>
</footer>
{% endblock %}
